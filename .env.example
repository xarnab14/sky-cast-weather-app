[TEMPLATE]
# Example environment file — copy to .env and fill in real values.
# The portfolio itself needs no secrets; SkyCast's server does:
#
#   cp .env.example .env   then edit

# Google AI Studio key — enables Gemini AI briefs + SkyArt (server-only, never shipped to the browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port for the SkyCast Express proxy (default 3000)
PORT=3000

# Optional: point the frontend at a remote proxy instead of localhost:3000
# VITE_SKYCAST_API="https://your-proxy.example.com"

# Reserved for future portfolio features (e.g. a Gemini-powered contact assistant)
APP_URL="MY_APP_URL"
